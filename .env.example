# ============================================================================
# Copiar a `.env` antes de ejecutar `docker compose up -d`
# ============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sql_reasoning_db

# Rol Administrador (Generación de dataset, poblamiento y ground-truth)
POSTGRES_ADMIN_USER=harness_admin
POSTGRES_ADMIN_PASSWORD=changeme_admin_password

# Rol de Solo Lectura para ejecución de consultas emitidas por el LLM
LLM_DB_USER=llm_readonly
LLM_DB_PASSWORD=changeme_readonly_password
LLM_STATEMENT_TIMEOUT_MS=3000
LLM_MAX_ROWS_RETURNED=50

# Configuración de Modelos e Inferencia
OLLAMA_HOST=http://localhost:11434
TARGET_MODEL_NAME=qwen2.5-coder:1.5b-instruct-q4_K_M
TEACHER_MODEL_NAME=qwen2.5-coder:7b-instruct
OLLAMA_NUM_THREADS=6
MAX_TOOL_TURNS=2
RANDOM_SEED=2026
