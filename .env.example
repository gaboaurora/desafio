# ============================================================================
# Copiar a `.env`. Todos los valores tienen defaults razonables; el archivo es opcional.
# ============================================================================

# Base de datos SQLite (se versiona en git; se regenera con generator/data_generator.py)
DB_PATH=db/hospital.sqlite

# Límites de la herramienta SQL que ejecuta consultas emitidas por el LLM
LLM_STATEMENT_TIMEOUT_MS=3000
LLM_MAX_ROWS_RETURNED=50
MAX_TOOL_TURNS=2

# Configuración de Modelos e Inferencia
OLLAMA_HOST=http://localhost:11434
TARGET_MODEL_NAME=qwen2.5-coder:1.5b-instruct-q4_K_M
TEACHER_MODEL_NAME=qwen2.5-coder:7b-instruct
# Capas a enviar a la GPU en cada request de Ollama (-1 = todas las que quepan en CUDA, 0 = CPU)
OLLAMA_NUM_GPU=-1

RANDOM_SEED=2026
